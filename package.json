{
  "name": "dsh-model-toggles",
  "version": "0.2.0",
  "private": true,
  "description": "DSH 模型能力勾选插件：在官方模型页每个模型条目里注入「图片输入」与思考强度（最低/低/中/高/超高/最高）勾选，写入 settings.yaml 的 input / reasoningEfforts",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "package.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "prepare": "pnpm run build",
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/smoke.mjs",
    "test:dom": "node scripts/dom-test.mjs",
    "test:client-state": "node scripts/client-state-test.mjs",
    "test": "pnpm run typecheck && pnpm run verify && pnpm run test:dom && pnpm run test:client-state",
    "verify:live": "node scripts/verify-live.mjs",
    "check:shadow": "node scripts/check-shadow.mjs",
    "plugin:install": "node scripts/install.mjs",
    "plugin:uninstall": "node scripts/uninstall.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "~18.3.1",
    "jsdom": "^30.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
